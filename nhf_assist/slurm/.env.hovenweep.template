# Hovenweep HPC Configuration
# Copy this to .env.hovenweep and fill in your values
# DO NOT commit the filled .env.hovenweep to git
#
# SSH connection: ssh -K <HPC_USER>@<HPC_HOST>
# Requires Kerberos auth (-K flag) and VPN connection
# Login nodes: hw-login1.gs.doi.net or hw-login2.gs.doi.net
#
# IMPORTANT: Run jobs from /caldera/projects, NOT from $HOME
# $HOME is for source code/scripts only. /caldera/projects is optimized
# for parallel I/O and large temporary storage.
# See: https://hpcportal.cr.usgs.gov/hpc-user-docs/guides/best-practices.html
#
# To find your SLURM account(s), run on HPC:
#   sacctmgr show association where user=$USER format=Account,QOS

HPC_USER=your_username
HPC_HOST=hw-login1.gs.doi.net
HPC_HOME=/home/your_username
HPC_WORK_DIR=/caldera/projects/your_project/your_username/gridmet_drivers
HPC_ACCOUNT=your_slurm_account
CONDA_DIR=/home/your_username/miniforge3
ENV_NAME=nhm-gridmet
PARTITION=cpu
