# hovenweep_config.env — settings for a PEST++ IES run on Hovenweep.
#
# TEMPLATE: replace every <PLACEHOLDER> with your values, then source this file
# (the transfer + SLURM scripts read it). A future `hovenweep_pest` setup
# notebook will fill these in for you. Do NOT commit personal paths/usernames —
# keep the committed template generic.

# --- Identity / allocation -------------------------------------------------
HPC_USER="<HPC_USER>"                    # your Hovenweep username
HPC_HOST="hw-login1.gs.doi.net"          # login node
HPC_ACCOUNT="<CENTER>"                    # SLURM allocation (your center, e.g. wawsc)
PARTITION="cpu"                           # SLURM partition
MAIL_USER="<USER>@usgs.gov"              # SLURM notifications

# --- Conda / modules -------------------------------------------------------
CONDA_DIR="/home/<HPC_USER>/miniforge3"  # base of your conda/miniforge install
ENV_NAME="<PYWATERSHED_ENV>"             # conda env with pywatershed (forward_run.py)
PESTPP_MODULE="pestpp/5.2.19"            # `module load` target for pestpp-ies

# --- Paths -----------------------------------------------------------------
# Remote run (template) directory — where the .pst and inputs live on /caldera.
REMOTE_RUN_DIR="/caldera/hovenweep/projects/usgs/water/<CENTER>/${HPC_USER}/<RUN_NAME>"
# Scratch base — per-job worker dirs are created under here.
SCRATCH_BASE="/caldera/hovenweep/projects/usgs/water/<CENTER>/${HPC_USER}/scratch"
# Local run directory on your workstation (source of the transfer).
LOCAL_RUN_DIR="<LOCAL_RUN_DIR>"          # e.g. path to your model's pestpp_ies/ dir

# --- PEST++ run ------------------------------------------------------------
CASE_NAME="<CASE_NAME>"                   # <CASE_NAME>.pst in the run dir
JOB_NAME="<JOB_NAME>"                     # SLURM job name / scratch tag
NTASKS=100                                 # 1 manager + (NTASKS-1) workers
WALLTIME="04:00:00"                       # HH:MM:SS (48h max on cpu)
